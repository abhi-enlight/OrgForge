[TEMPLATE]
# ── Forge web app (apps/web, port 3000) ───────────────────────────────────────
# Copy to .env.local and fill in. Same Supabase project as the unified API.
#
# The web app only reads the NEXT_PUBLIC_* vars below — they are already the
# canonical names. Every SERVER-side var (Supabase service role, Salesforce
# OAuth, Gemini, Redis, feature flags, cron, GitHub) lives in the ROOT
# `.env.example` and uses the canonical names there (SALESFORCE_*,
# GOOGLE_AI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, ...). Legacy Agentforge/
# OrgForge names are still honored as fallbacks where noted in the root file;
# JWT_SECRET is retired (plan §8.3).

# Supabase (shared project — required for login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Unified API backend (rewrites /api/* to this origin)
# `BACKEND_URL` (no NEXT_PUBLIC_ prefix) is still honored as a legacy fallback
# by next.config.ts: NEXT_PUBLIC_BACKEND_URL || BACKEND_URL || http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Canonical site URL (metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canary flag (plan §14.2) — `on` enables canary-only affordances, today the
# stub rule-based routing preview in the Copilot capability chip (zero AI risk,
# §14.2 Phase 1). `off` (default) ships the app with no canary features.
# Deploy-time knob for the canary group only (inlined at build time).
# Mirrors FORGE_UNIFIED_FRONTEND in the root .env.example — set either; the web
# app reads this NEXT_PUBLIC_ name at build time.
NEXT_PUBLIC_FORGE_UNIFIED_FRONTEND=off
