# Forge (unified platform) — environment reference.
# One self-contained app (Pass 32 native port). Both engines read the SAME
# names; legacy Agentforge/OrgForge names are still honored as fallbacks where
# noted, so existing env files keep working.
# Retired: JWT_SECRET (plan §8.3 — identity is Supabase auth; the legacy
# Agentforge JWT flow now fails at use with a clear error if unset, never at
# boot).
# Transition-only (removed after Phase 5): LEGACY_JWT_SECRET, SESSION_SECRET
# (SESSION_SECRET is still required by the Agentforge /api/auth alias router
# during the FORGE_MOUNT_AGENTFORGE transition window — hard-required in prod).

# ── Server ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Frontend origin used by OAuth post-login redirects (Agentforge alias flow).
FRONTEND_URL=http://localhost:3000
# Feature flags (plan §14.2). FORGE_UNIFIED_FRONTEND is the web canary gate —
# consumed by the web app as NEXT_PUBLIC_FORGE_UNIFIED_FRONTEND (set it in
# frontend/.env.local / Vercel env before `next build`): `on` enables
# canary-only affordances (stub rule-based routing preview in the Copilot chip).
FORGE_UNIFIED_FRONTEND=off
FORGE_UNIFIED_API=off      # mount the OrgForge capability routers + start the BullMQ workers
FORGE_MOUNT_AGENTFORGE=off # mount the Agentforge capability routers + legacy /api/auth, /api/org aliases
FORGE_ROUTER=off

# ── Supabase (single project, shared by both engines) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Legacy aliases still honored (ported Agentforge dbClient):
#   PROJECT_URL, SERVICE_ROLE_KEY

# ── Salesforce OAuth (single unified ECA — DECISIONS.md D7) ─────────────
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Single redirect URI shared by the unified OAuth flow AND the ported Agentforge alias flow
# (SF_CALLBACK_URL collapsed into this). Must exactly match the callback registered on the
# Salesforce Connected App / ECA. With FORGE_MOUNT_AGENTFORGE=off, use the unified path below.
SALESFORCE_REDIRECT_URI=http://localhost:3001/api/v1/auth/salesforce/callback
# Legacy aliases still honored (ported Agentforge OAuth):
#   SF_OAUTH_CLIENT_ID, SF_OAUTH_CLIENT_SECRET, SF_CALLBACK_URL
# Scope union kept for parity (DECISIONS.md D3): api web refresh_token
# einstein_gpt_api full sfap_api openid id

# ── Encryption & signing ────────────────────────────────────────────────
ENCRYPTION_KEY= # 64-hex-char (openssl rand -hex 32) — one key for the unified app (D4)
HMAC_SECRET=     # >=32 chars — signs change records + agent deploys
# Legacy JWT secret, present ONLY during the re-link window (§8.4), then removed
LEGACY_JWT_SECRET=

# ── Gemini ──────────────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
JUDGE_MODEL=gemini-3.5-flash
# Optional classifier override (packages/ai defaults to GEMINI_MODEL).
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash
# Legacy alias still honored (ported Agentforge Gemini): GEMINI_API_KEY

# ── Salesforce API version (ported Agentforge REST calls) ───────────────
SF_API_VERSION=v65.0

# ── Org-change connector (ECA) package pins ─────────────────────────────
# SubscriberPackageId + version for the org-change connector package checks.
ORGFORGE_PACKAGE_ID=033fj000000PqLBAA0
# Unified name (diagnostics preflight + org-change capability).
FORGE_ECA_PACKAGE_VERSION_ID=04tfj000000NNITAA4
# Legacy alias still honored: ORGFORGE_PACKAGE_VERSION_ID

# ── Redis + BullMQ ──────────────────────────────────────────────────────
# REDIS_URL also backs the agent-engine conversation store: busy locks + serializable
# conversation state keyed by {user_id, org_id, session_id} (plan §7.3). Unreachable
# Redis degrades to in-memory — never crashes or hangs a request.
REDIS_URL=redis://localhost:6379
ADMIN_USER=
ADMIN_PASS=

# ── GitHub audit App ────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=

# ── Internal cron ───────────────────────────────────────────────────────
CRON_SECRET=
